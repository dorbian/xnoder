[Unit]
Description=OpenClaw Node Workstation Container
Wants=network-online.target
After=network-online.target

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

EnvironmentFile=/opt/openclaw-node/secrets/openclaw-node.env

ExecStartPre=-/usr/bin/podman rm -f openclaw-node
ExecStart=/usr/bin/podman run \
  --name openclaw-node \
  --replace \
  --rm \
  --shm-size=2g \
  --security-opt seccomp=unconfined \
  --env-file /opt/openclaw-node/secrets/openclaw-node.env \
  -p 127.0.0.1:18789:18789 \
  -p 127.0.0.1:9222:9222 \
  -p 127.0.0.1:5900:5900 \
  -p 127.0.0.1:6080:6080 \
  -v openclaw-workspace:/opt/openclaw-node/workspace:Z \
  -v openclaw-state:/opt/openclaw-node/state:Z \
  -v openclaw-browser:/opt/openclaw-node/browser-profile:Z \
  -v openclaw-logs:/opt/openclaw-node/logs:Z \
  ${OPENCLAW_IMAGE:-localhost/openclaw-node-workstation:latest} node

ExecStop=/usr/bin/podman stop -t 20 openclaw-node
KillMode=mixed
TimeoutStopSec=60
Delegate=yes

[Install]
WantedBy=multi-user.target
