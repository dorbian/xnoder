# Copy this file to /opt/openclaw-node/secrets/openclaw-node.env on the FCOS/bootc host.
# Do not commit the real file.

OPENCLAW_GATEWAY_URL=ws://REPLACE_WITH_GATEWAY_IP_OR_DNS:18789
OPENCLAW_NODE_TOKEN=REPLACE_WITH_NODE_JOIN_TOKEN
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_GATEWAY_TOKEN_IF_DIFFERENT
OPENCLAW_NODE_NAME=openclaw-node-01
OPENCLAW_LOG_LEVEL=info

VNC_PASSWORD=REPLACE_WITH_VNC_PASSWORD
DISPLAY=:1
CHROME_DEBUG_PORT=9222
VNC_PORT=5900
NOVNC_PORT=6080
ENABLE_VNC=1
ENABLE_NOVNC=1
HEADLESS=0
