# Copy this file to /opt/openclaw-node/secrets/openclaw-node.env on the FCOS/bootc host.
# Do not commit the real file.

OPENCLAW_GATEWAY_URL=ws://REPLACE_WITH_GATEWAY_IP_OR_DNS:18789
# Used by the rendered config. For node run, this is the important token.
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_GATEWAY_TOKEN
# Backward-compatible only. node run itself does not receive this as a CLI flag.
OPENCLAW_NODE_TOKEN=REPLACE_WITH_NODE_JOIN_TOKEN_IF_YOU_HAVE_ONE
OPENCLAW_NODE_NAME=openclaw-node-01
# Address/port the node advertises/listens on. Set this to the host LAN IP if needed.
OPENCLAW_NODE_HOST=0.0.0.0
OPENCLAW_WEB_PORT=18789
OPENCLAW_LOG_LEVEL=info

VNC_PASSWORD=REPLACE_WITH_VNC_PASSWORD
DISPLAY=:1
CHROME_DEBUG_PORT=9222
VNC_PORT=5900
NOVNC_PORT=6080
ENABLE_VNC=1
ENABLE_NOVNC=1
HEADLESS=0

# OpenClaw process mode. Usually node. Use gateway only if this container should host the gateway.
OPENCLAW_MODE=node
# Emergency escape hatch if your installed OpenClaw CLI uses different arguments.
# OPENCLAW_COMMAND_OVERRIDE='openclaw node run --host 192.168.0.202 --port 18789 --display-name xcp01-node'
